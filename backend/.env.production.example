APP_ENV=production
APP_DEBUG=false
APP_URL=https://api.example.com

# Use the managed PostgreSQL connection in production.
DB_CONNECTION=pgsql
DB_HOST=postgres.example.com
DB_PORT=5432
DB_DATABASE=gestion_master
DB_USERNAME=replace-me
DB_PASSWORD=replace-me

# Use HTTPS for all frontend clients.
SANCTUM_STATEFUL_DOMAINS=api.example.com